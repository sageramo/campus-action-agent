.ink-page { display: flex; flex-direction: column; height: 100vh; background: #f4f8fc; }
.ink-scroll { flex: 1; min-height: 0; }
.ink-content { padding: 34rpx 32rpx 18rpx; }
.ink-welcome { margin-top: 14vh; }
.ink-welcome .h1 { margin-bottom: 12rpx; }
.ink-welcome .muted { max-width: 500rpx; margin-bottom: 26rpx; }
.ink-welcome .btn { display: inline-block; margin: 0 12rpx 12rpx 0; }
.exchange { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 32rpx; font-size: 29rpx; line-height: 1.6; }
.ink-user, .ink-reply { white-space: pre-wrap; overflow-wrap: anywhere; }
.ink-user { align-self: flex-end; max-width: 83%; max-height: 320rpx; overflow: auto; padding: 16rpx 22rpx; border-radius: 26rpx 26rpx 6rpx 26rpx; background: #e6effa; }
.ink-link { align-self: flex-start; }
.ink-dock { flex: none; padding: 12rpx 24rpx 18rpx; }
.ink-dock > .muted, .ink-dock > .error { padding: 0 6rpx 12rpx; }
.ink-compose { border: 1px solid #c7d7e8; border-radius: 28rpx; padding: 12rpx 16rpx; background: #fff; }
.ink { box-sizing: border-box; width: 100%; height: 134rpx; padding: 12rpx 10rpx; font-size: 30rpx; line-height: 1.5; }
.ink-tools { display: flex; align-items: center; gap: 16rpx; }
.ink-tools .btn, .ink-tools .mode { min-height: 76rpx; display: flex; align-items: center; justify-content: center; }
.mode { padding: 0 16rpx; color: #38516e; font-size: 25rpx; }
.ink-tools .ink-send { margin-left: auto; }
.ink-dock .ink-privacy { padding: 9rpx 6rpx 0; }
