.gap { margin-top: 20rpx; }
.nav { margin-top: 20rpx; }
.stats { display: flex; justify-content: space-between; text-align: center; }
.stat { display: flex; flex-direction: column; }
.num { font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 800; }
.badge { display: inline-block; min-width: 36rpx; padding: 0 10rpx; border-radius: 999rpx; background: var(--gold); color: #fff; font-size: 22rpx; text-align: center; vertical-align: 6rpx; }
.undo { justify-content: space-between; padding: 12rpx 16rpx; border-radius: 16rpx; background: var(--sage-soft); color: var(--sage-deep); font-size: 24rpx; margin-bottom: 16rpx; }
.leave { padding: 20rpx; border-radius: 16rpx; border: 2rpx solid var(--line); margin-bottom: 20rpx; }
.leave-text { margin: 12rpx 0 16rpx; font-size: 26rpx; line-height: 1.7; user-select: text; }
.cx { padding: 20rpx; border-radius: 20rpx; border: 2rpx solid #ecc7c3; border-left: 8rpx solid var(--conflict); margin-top: 16rpx; }
.cx-head { display: flex; justify-content: space-between; align-items: baseline; }
.cx-label { color: var(--conflict); font-family: "Songti SC", serif; font-weight: 700; font-size: 30rpx; }
.cx-advice { margin: 8rpx 0 12rpx; color: var(--muted); font-family: "Kaiti SC", serif; font-size: 24rpx; }
.cx-option { display: block; width: 100%; margin: 12rpx 0 0; padding: 16rpx 20rpx; border-radius: 16rpx; background: #f7f9fc; border: 2rpx solid var(--line); text-align: left; line-height: 1.5; }
.cx-option::after { border: none; }
.cx-option.is-rec { background: var(--accent); border-color: var(--accent); color: #fff; }
.cx-option-label { font-size: 28rpx; font-weight: 600; }
.cx-option-detail { font-size: 22rpx; opacity: .8; }
.tag.rec { background: rgba(255, 255, 255, .25); margin-right: 8rpx; }
.day.is-today { box-shadow: 0 0 0 3rpx var(--accent), 0 8rpx 32rpx rgba(37, 99, 184, .12); }
.day.is-past { opacity: .6; }
.day-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.day-label { font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; }
.tag.today { background: var(--accent); color: #fff; }
.free { margin-left: auto; }
.cal-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 18rpx; margin-top: 10rpx; border-radius: 14rpx; background: #f7f9fc; border-left: 8rpx solid var(--line); }
.time { width: 190rpx; flex: none; font-variant-numeric: tabular-nums; color: var(--muted); font-size: 24rpx; }
.title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.layer { flex: none; font-size: 22rpx; color: var(--muted); }
.layer-routine { border-left-color: var(--routine); }
.layer-work { border-left-color: var(--work); }
.layer-appointment { border-left-color: var(--appt); }
.layer-temporary { border-left-color: var(--temp); }
.layer-deadline { border-left-color: var(--gold); background: #fff8ec; }
.layer-start { border-left-color: var(--temp); background: #f1f3f6; }
.is-conflict { box-shadow: inset 0 0 0 2rpx var(--conflict); }
