/* 晴空色板，与网页版工作台一致 */
page { --bg: #f4f8fc; --panel: #ffffff; --text: #1d2a38; --muted: #586577; --line: #dde5ee; --accent: #2563b8; --accent-deep: #1d4f94; --accent-soft: #e6effa;
  --routine: #6f8dab; --work: #d18f55; --appt: #efca8e; --temp: #1f2d3d; --conflict: #a2332d; --gold: #e09a35; --sage-soft: #e3f2e8; --sage-deep: #2f6e48;
  background: var(--bg); color: var(--text); font-family: -apple-system, "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.6; }
.wrap { padding: 24rpx 28rpx 48rpx; }
.card { background: var(--panel); border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(29, 42, 56, .06); }
.h1 { font-family: "Songti SC", serif; font-size: 48rpx; font-weight: 800; letter-spacing: 2rpx; }
.h2 { font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 700; margin-bottom: 12rpx; }
.eyebrow { color: var(--accent); font-size: 22rpx; letter-spacing: 6rpx; }
.muted { color: var(--muted); font-size: 24rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.btn { display: inline-flex; align-items: center; justify-content: center; height: 76rpx; padding: 0 32rpx; border-radius: 999rpx; border: 2rpx solid var(--line); background: #fff; color: var(--text); font-size: 28rpx; line-height: 76rpx; margin: 0; }
.btn::after { border: none; }
.btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
.btn.small { height: 60rpx; line-height: 60rpx; padding: 0 24rpx; font-size: 24rpx; }
.btn.block { display: flex; width: 100%; }
.tag { display: inline-block; padding: 0 12rpx; border-radius: 999rpx; font-size: 20rpx; line-height: 34rpx; }
.notice { padding: 20rpx 24rpx; border-radius: 16rpx; background: var(--accent-soft); color: var(--accent-deep); font-size: 24rpx; }
.error { color: var(--conflict); font-size: 24rpx; }
